# Copia este archivo como docker/.env (junto a compose.yaml) y completa lo que uses.
# El archivo .env tiene tus API keys: no lo subas a git ni lo compartas.

# Dónde publicar el puerto del núcleo:
#   127.0.0.1      solo este equipo (por defecto)
#   100.x.y.z      la IP de Tailscale del servidor (recomendado para usarlo desde otros equipos)
#   0.0.0.0        toda la red; todas las rutas piden token, pero no hay TLS
GMINI_BIND=127.0.0.1
GMINI_PORT=8765
TZ=America/Lima

# Versión del núcleo al construir la imagen localmente (docker compose build).
GMINI_CORE_REF=v0.2.0
# Etiqueta de la imagen publicada en GHCR (latest o una versión, p. ej. 0.1.0).
GMINI_IMAGE_TAG=latest

# API keys del agente. El núcleo lee GMINI_KEY_<NOMBRE> antes que el llavero;
# un valor vacío se ignora. El proveedor por defecto es Google (Gemini).
GMINI_KEY_GOOGLE_API=
GMINI_KEY_OPENAI_API=
GMINI_KEY_ANTHROPIC_API=
# GMINI_KEY_DEEPSEEK_API=
# GMINI_KEY_GROQ_API=
# GMINI_KEY_OPENROUTER_API=

# Vertex AI con una cuenta de servicio: copia el JSON al volumen y apunta aquí.
# GOOGLE_APPLICATION_CREDENTIALS=/data/vertex-sa.json
